{
  "name": "three-kingdoms-game",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "node tools/deploy.mjs",
    "check:boundaries": "node tools/check-boundaries.mjs",
    "test": "node --test tests/*.test.ts",
    "verify": "npm run check:boundaries && tsc --noEmit && npm test",
    "balance": "node tools/balance.ts",
    "world": "node tools/world.ts",
    "battle": "node tools/battle.ts",
    "field": "node tools/field.ts",
    "camp": "node tools/camp.ts",
    "campaign": "node tools/campaign.ts",
    "theatre": "node tools/theatre.ts",
    "general": "node tools/general.ts",
    "court": "node tools/court.ts"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.181.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.181.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
